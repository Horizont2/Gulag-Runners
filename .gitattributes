# ─────────────────────────────────────────────────────────────────────────────
# Gulag Runners — .gitattributes
#
# Without this file a Unity project breaks for a team in two ways:
#   1) Windows and macOS normalise line endings differently, so scene and prefab
#      YAML conflicts on every single line;
#   2) git tries to merge binary assets as text and corrupts them.
# ─────────────────────────────────────────────────────────────────────────────

# By default let git detect text and normalise it to LF inside the repository.
* text=auto

# ── Unity YAML: text, but only ever merged with UnityYAMLMerge ──────────────
# For merge=unity to do anything, each person runs this once:
#   git config merge.unity.name "UnityYAMLMerge"
#   git config merge.unity.driver "'<path to UnityYAMLMerge>' merge -p %O %B %A %A"
# UnityYAMLMerge ships with the editor: Editor/Data/Tools/UnityYAMLMerge(.exe)
*.unity      text eol=lf merge=unity
*.prefab     text eol=lf merge=unity
*.asset      text eol=lf merge=unity
*.mat        text eol=lf merge=unity
*.anim       text eol=lf merge=unity
*.controller text eol=lf merge=unity
*.overrideController text eol=lf merge=unity
*.physicMaterial     text eol=lf merge=unity
*.physicsMaterial2D  text eol=lf merge=unity
*.playable   text eol=lf merge=unity
*.mask       text eol=lf merge=unity
*.brush      text eol=lf merge=unity
*.flare      text eol=lf merge=unity
*.fontsettings text eol=lf merge=unity
*.guiskin    text eol=lf merge=unity
*.giparams   text eol=lf merge=unity
*.renderTexture text eol=lf merge=unity
*.lighting   text eol=lf merge=unity
*.terrainlayer  text eol=lf merge=unity
*.signal     text eol=lf merge=unity
*.spriteatlas   text eol=lf merge=unity
*.meta       text eol=lf merge=unity

# ── Code and configuration ──────────────────────────────────────────────────
*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.hlsl      text eol=lf
*.cginc     text eol=lf
*.compute   text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.inputactions text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf

# ── Scripts: line endings decide whether they run at all ────────────────────
*.sh        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# ── Binary: never touch ─────────────────────────────────────────────────────
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.tga  binary
*.tif  binary
*.tiff binary
*.exr  binary
*.hdr  binary
*.bmp  binary
*.ico  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.dae  binary
*.3ds  binary
*.gltf binary
*.glb  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aif  binary
*.aiff binary
*.mp4  binary
*.mov  binary
*.webm binary
*.ttf  binary
*.otf  binary
*.unitypackage binary
*.dll  binary
*.so   binary
*.a    binary
*.dylib binary
*.pdb  binary
*.zip  binary
*.7z   binary

# ── Git LFS ─────────────────────────────────────────────────────────────────
# Do NOT enable until git-lfs is installed by EVERYONE on the team.
# If LFS is on and someone does not have it, they get a few-line text stub instead
# of every texture and model. That is exactly the "I have no files" symptom, and it
# costs more to undo later than it costs to agree on it now.
#
# Once everyone has run `git lfs install`, uncomment:
# *.png  filter=lfs diff=lfs merge=lfs -text
# *.psd  filter=lfs diff=lfs merge=lfs -text
# *.fbx  filter=lfs diff=lfs merge=lfs -text
# *.wav  filter=lfs diff=lfs merge=lfs -text
# *.mp4  filter=lfs diff=lfs merge=lfs -text
